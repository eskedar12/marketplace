# ---------- Server ----------
NODE_ENV=development
PORT=5000

# ---------- Database ----------
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/vintech_marketplace

# ---------- Auth ----------
JWT_SECRET=change_this_to_any_long_random_string_of_your_choosing
JWT_EXPIRES_IN=7d

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ---------- Fayda (Ethiopian national ID) verification ----------
# Defaults to true — no real Fayda credentials needed to try the flow.
# Set to false once you have real credentials from id.gov.et/api.
FAYDA_MOCK_MODE=true
# Only needed once FAYDA_MOCK_MODE=false:
# FAYDA_CLIENT_ID=
# FAYDA_AUTHORIZE_URL=
# FAYDA_TOKEN_URL=
# FAYDA_USERINFO_URL=
# FAYDA_JWKS_URL=